+pgbin=${1:?Usage: bash tests/run_slot_postgres.sh /absolute/path/to/postgresql/bin}
+python_bin=${PYTHON:-python}
+export PYTHONPATH="$PWD"
+tmp=$(mktemp -d)
+trap '"$pgbin/pg_ctl" -D "$tmp/db" -m immediate stop >/dev/null 2>&1 || true; rm -rf -- "$tmp"' EXIT
+mkdir -m 700 "$tmp/socket"
+"$pgbin/initdb" --auth=trust --username=fbapp_slot_test --encoding=UTF8 --no-locale -D "$tmp/db" >/dev/null
+"$pgbin/pg_ctl" -D "$tmp/db" -l "$tmp/postgres.log" -o "-k '$tmp/socket' -c listen_addresses=''" -w start >/dev/null
+"$pgbin/createdb" -h "$tmp/socket" -U fbapp_slot_test fbapp_slot_test
+FB_APP_SLOT_TEST_SOCKET="$tmp/socket" "$python_bin" -m unittest discover -s tests -p test_slot_postgres.py -v
