+"""PostgreSQL roundtrips confined to the isolated Unix socket from run_slot_postgres.sh."""
+import importlib.util
+import os
+import stat
+from concurrent.futures import ThreadPoolExecutor
+from datetime import datetime
+from pathlib import Path
+from threading import Barrier
+from types import SimpleNamespace
+import unittest
+
+import pandas as pd
+from sqlalchemy import Text, URL, create_engine, text
+
+
+SOCKET = os.environ.get('FB_APP_SLOT_TEST_SOCKET')
+ROOT = Path(__file__).resolve().parents[1]
+
+
+@unittest.skipUnless(SOCKET, 'Run tests/run_slot_postgres.sh for isolated PostgreSQL')
+class SlotPostgres(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        sock = Path(SOCKET)
+        if (not sock.is_absolute() or sock.name != 'socket' or not sock.parent.name.startswith('tmp.')
+                or sock.is_symlink() or sock.stat().st_uid != os.getuid() or stat.S_IMODE(sock.stat().st_mode) != 0o700):
+            raise RuntimeError('Expected disposable private Unix socket only')
+        cls.engine = create_engine(URL.create('postgresql+psycopg2', username='fbapp_slot_test',
+                                             database='fbapp_slot_test', query={'host': str(sock)}))
+        with cls.engine.connect() as conn:
+            assert conn.execute(text("SELECT current_database(), current_user, inet_server_addr(), "
+                                     "current_setting('listen_addresses')")).one() == (
+                'fbapp_slot_test', 'fbapp_slot_test', None, '')
+        spec = importlib.util.spec_from_file_location('fbapp_slot_candidate', ROOT / 'FB-app.py')
+        cls.app = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(cls.app)
+        cls.app.get_hkt_now = lambda: datetime(2026, 11, 21, 0, 25, tzinfo=cls.app.HKT)
+        cls.app._v163_sql_engine = lambda: cls.engine
+        cls.app._has_secret = lambda key: key == 'DB_URL'
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.engine.dispose()
+
+    def setUp(self):
+        self.errors = []
+        self.app.st = SimpleNamespace(session_state={}, error=self.errors.append)
+        with self.engine.begin() as conn:
+            conn.execute(text('DROP TABLE IF EXISTS public.football_bets, public.football_bets_deleted, public.football_schedule'))
+            conn.execute(text('CREATE TABLE public.football_schedule ("Key" text, "Value" text)'))
+            conn.execute(text('ALTER TABLE public.football_schedule ENABLE ROW LEVEL SECURITY'))
+            conn.execute(text('CREATE TABLE public.football_bets_deleted (id text PRIMARY KEY, deleted_at text)'))
+            conn.execute(text('INSERT INTO public.football_schedule VALUES '
+                              """('enabled','1'), ('time','05:00'), ('t0','00:00'), ('t1','23:59'),
+                                 ('last_run','nan'), ('settlement_slots','00:00'), ('extension','keep')"""))
+        self.key = '2026-11-21 00:00'
+
+    def schedule_identity(self):
+        with self.engine.connect() as conn:
+            return tuple(conn.execute(text("""
+                SELECT oid, relrowsecurity FROM pg_class WHERE oid = 'public.football_schedule'::regclass
+            """)).one())
+
+    def test_two_sessions_claim_same_slot_only_once(self):
+        identity = self.schedule_identity()
+        barrier = Barrier(2)
+        def attempt(_):
+            barrier.wait(timeout=5)
+            return self.app._v18_claim_slot(self.engine, self.key)
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            self.assertEqual(sorted(pool.map(attempt, (1, 2))), [False, True])
+        self.assertEqual(self.app._v1511_sched_load(fresh=True)['settlement_slot_claim'], self.key)
+        self.assertEqual(identity, self.schedule_identity())
+
+    def test_setting_and_legacy_marker_updates_keep_table_and_claim(self):
+        identity = self.schedule_identity()
+        self.assertTrue(self.app._v18_claim_slot(self.engine, self.key))
+        cfg = self.app._v1511_sched_load(fresh=True)
+        self.assertTrue(self.app._v1511_sched_save(dict(cfg, settlement_slots='03:00'), settings_only=True))
+        self.assertTrue(self.app._v1511_sched_save(dict(cfg, last_run='2026-11-20', last_run_win='00:00-23:59')))
+        saved = self.app._v1511_sched_load(fresh=True)
+        self.assertEqual((saved['settlement_slots'], saved['settlement_slot_claim'], saved['last_run']),
+                         ('03:00', self.key, '2026-11-20'))
+        with self.engine.connect() as conn:
+            self.assertEqual(conn.execute(text("""SELECT "Value" FROM public.football_schedule
+                                                   WHERE "Key" = 'extension'""")).scalar_one(), 'keep')
+        self.assertEqual(identity, self.schedule_identity())
+
+    def test_stale_slot_or_deselection_cannot_claim(self):
+        self.assertFalse(self.app._v18_claim_slot(self.engine, '2026-11-20 21:00'))
+        cfg = self.app._v1511_sched_load(fresh=True)
+        self.assertTrue(self.app._v1511_sched_save(dict(cfg, settlement_slots=''), settings_only=True))
+        self.assertFalse(self.app._v18_claim_slot(self.engine, self.key))
+        self.assertNotIn('settlement_slot_claim', self.app._v1511_sched_load(fresh=True))
+
